# ============================================
# 1. LLM & EMBEDDING CONFIGURATION (OLLAMA)
# ============================================
# Ollama runs locally, so no API key is needed (we use a dummy one for LangChain compatibility)
OLLAMA_API_KEY=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1

# Models to use (must be pulled via `ollama pull <model>`)
LLM_MODEL=qwen2.5:7b
EMBEDDING_MODEL=nomic-embed-text

# ============================================
# 2. VECTOR DATABASE (CHROMADB - LOCAL)
# ============================================
# ChromaDB stores our embedded PDF policies locally
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=finance_policies

# ============================================
# 3. RELATIONAL DATABASE (SQLITE - LOCAL)
# ============================================
# SQLite stores the Kaggle bank transaction data
SQLITE_DB_PATH=./data/finance_bank.db

# ============================================
# 4. RAG / DOCUMENT PROCESSING CONFIG
# ============================================
# Chunking strategy for the PDF policies
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# ============================================
# 5. AGENT CONFIGURATION
# ============================================
# Temperature for the LLM (0.0 = deterministic, good for SQL/routing)
LLM_TEMPERATURE=0.0

# Maximum number of retries for self-correction loops
MAX_AGENT_RETRIES=3

# ============================================
# 6. OPTIONAL: EXTERNAL TOOLS
# ============================================
# Tavily API for web search (optional - get free key at tavily.com)
# TAVILY_API_KEY=tvly-xxxxxxxxxxxxx

# OpenAI API key (optional - only needed if you want to fallback to GPT-4o-mini for evaluation)
# OPENAI_API_KEY=sk-xxxxxxxxxxxxx

# ============================================
# 7. APPLICATION SETTINGS
# ============================================
DEBUG=true
LOG_LEVEL=INFO